# Copy this file to .env and set a token before starting the HTTP quick start.
# LogStreamer does not load dotenv files itself; Compose reads this file, and
# local runs can export its values into the shell.
LOGSTREAMER_INGEST_TOKEN=

# Used only by compose.yaml for the host-side port. The service remains bound
# to container port 8080.
LOGSTREAMER_PORT=8080

# Compose mounts this YAML file as the service config. Change it when trying a
# collector-specific example.
LOGSTREAMER_CONFIG_FILE=./config.example.yaml
